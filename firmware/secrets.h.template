// ==================== WIFI CONFIGURATION ====================
// Your WiFi network credentials
#define WIFI_SSID "YOUR_WIFI_NAME"       // Replace with your WiFi name
#define WIFI_PASSWORD "YOUR_WIFI_PASS"   // Replace with your WiFi password

// ==================== SERVER CONFIGURATION ====================
// Your backend server IP address and port
// Find your PC's IP: Windows → ipconfig → IPv4 Address

#define SERVER_IP "192.168.1.XX"    // Replace with your server PC's IP
#define SERVER_PORT 3000             // Default backend port

// Option: Ngrok Public URL (Over internet)
// Uncomment this line and paste your Ngrok URL (WITHOUT a trailing slash)
// #define NGROK_URL "https://your-ngrok-url.ngrok-free.dev"

// Full server URLs (auto-constructed based on which option you use)
#ifdef NGROK_URL
  #define SERVER_URL_TRANSACTION NGROK_URL "/api/transaction"
  #define SERVER_URL_CONSUMPTION NGROK_URL "/api/consumption"
  #define SERVER_URL_LIVE NGROK_URL "/api/live"
#else
  #define SERVER_URL_TRANSACTION "http://" SERVER_IP ":" "3000" "/api/transaction"
  #define SERVER_URL_CONSUMPTION "http://" SERVER_IP ":" "3000" "/api/consumption"
  #define SERVER_URL_LIVE "http://" SERVER_IP ":" "3000" "/api/live"
#endif

